<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="0dp"
    android:padding="10dp"
    android:background="@color/Purple3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="5dp">

        <Button
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/rounded_button_background"
            android:backgroundTint="@color/Purple6"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/Purple4"
            android:textSize="15dp" />

        <Button
            android:id="@+id/home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/rounded_button_background"
            android:backgroundTint="@color/Purple6"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="@color/Purple4"
            android:textSize="15dp" />
    </LinearLayout>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_margin="5dp">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/pp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="0.75"
            android:text="John Doe"
            android:textAlignment="center"
            android:textColor="@color/Purple4"
            android:textSize="30sp" />

    </LinearLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FlashCard Creator"
        android:layout_gravity="center"
        android:textAlignment="center"
        android:textSize="40dp"
        android:textColor="@color/Purple4"
        android:layout_marginBottom="50dp"
        android:layout_marginTop="20dp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp"
        android:layout_margin="5dp">



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Side 1 Here:"
            android:textSize="15sp"
            android:textColor="@color/Purple4"
            android:layout_margin="5dp"
            />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="What has keys but can't open locks?"
            android:inputType="textMultiLine"
            android:textColor="@color/Purple4"
            android:textSize="25sp"
            android:layout_margin="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Side 2 Here:"
            android:textSize="15sp"
            android:textColor="@color/Purple4"
            android:layout_margin="5dp"
            />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="A Piano"
            android:inputType="textMultiLine"
            android:textColor="@color/Purple4"
            android:textSize="25sp"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rounded_button_background"
            android:backgroundTint="@color/Purple4"
            android:padding="15dp"
            android:text="Save"
            android:textColor="@color/Purple2"
            android:textSize="25sp" />


    </LinearLayout>





</LinearLayout>