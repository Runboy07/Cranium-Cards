<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="40dp"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingBottom="10dp"
    android:orientation="vertical"
    android:background="@color/Purple5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="10dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/pp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="John Doe"
            android:textAlignment="center"
            android:layout_weight="0.75"
            android:textSize="40dp"
            android:textColor="@color/Purple4"/>


    </LinearLayout>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="2dp"
    android:padding="10dp">

    <Button
        android:id="@+id/viewCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_button_background"
        android:backgroundTint="@color/Purple6"
        android:text="View Flashcards"
        android:textAllCaps="false"
        android:textColor="@color/Purple4"
        android:textSize="24sp" />

    <Button
        android:id="@+id/createCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_button_background"
        android:backgroundTint="@color/Purple6"
        android:text="Create New Flashcards"
        android:textAllCaps="false"
        android:textColor="@color/Purple4"
        android:textSize="24sp" />

    <Button
        android:id="@+id/shareCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_button_background"
        android:backgroundTint="@color/Purple6"
        android:text="Share Flashcards"
        android:textAllCaps="false"
        android:textColor="@color/Purple4"
        android:textSize="24sp" />

    <Button
        android:id="@+id/deleteCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_button_background"
        android:backgroundTint="@color/Purple6"
        android:text="Delete Flashcards"
        android:textAllCaps="false"
        android:textColor="@color/Purple4"
        android:textSize="24sp" />

    <Button
        android:id="@+id/profileSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/rounded_button_background"
        android:backgroundTint="@color/Purple6"
        android:text="Profile Settings"
        android:textAllCaps="false"
        android:textColor="@color/Purple4"
        android:textSize="24sp" />
</LinearLayout>




</LinearLayout>